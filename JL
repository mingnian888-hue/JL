import random

idioms = ["画龙点睛", "惊天动地", "地久天长", "长年累月", "月下老人", "人山人海", "海阔天空"]

def idiom_game():
    used = []
    current = random.choice(idioms)
    used.append(current)
    print(f"游戏开始，电脑先说: {current}")

    while True:
        player = input("你接的成语: ").strip()
        if player in used or player not in idioms:
            print("无效或已使用，请重新输入！")
            continue
        if player[0] != current[-1]:
            print(f"必须以 '{current[-1]}' 开头！")
            continue
        used.append(player)
        current = player

        # 电脑接
        possible = [i for i in idioms if i[0] == current[-1] and i not in used]
        if possible:
            current = random.choice(possible)
            used.append(current)
            print(f"电脑接: {current}")
        else:
            print("电脑无法接了，你赢了！")
            break

if __name__ == "__main__":
    idiom_game()
